<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_operations"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_op_add" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_op_sub" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkMul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_op_mul" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkDiv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_op_div" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_difficulty"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioEasy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_diff_easy" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_diff_medium" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioHard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_diff_hard" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_behavior"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchLockOnScreenOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_lock_on_screen_on" />

    </LinearLayout>

</ScrollView>
